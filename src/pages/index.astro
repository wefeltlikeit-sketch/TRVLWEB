---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import GearCard from '../components/GearCard.astro';
import EuropeMap from '../components/EuropeMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Decor from '../components/Decor.astro';
import { withBase } from '../lib/paths';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts[0];
const secondary = posts.slice(1, 3);
const latest = posts.slice(0, 3);

const gear = (await getCollection('gear')).sort(
  (a, b) => Number(b.data.sponsor) - Number(a.data.sponsor)
).slice(0, 3);

const destinationCount = (await getCollection('destinations')).length;

const dateLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const strip = [
  { src: '/images/scenes/cheese-counter.svg', cap: 'Comté, aged eighteen months' },
  { src: '/images/scenes/cobblestone-lane.svg', cap: 'A lane with no name' },
  { src: '/images/scenes/market-stall.svg', cap: 'Market morning' },
  { src: '/images/scenes/rooftops.svg', cap: 'Red roofs from above' },
  { src: '/images/scenes/coast-aerial.svg', cap: 'The coast, from the air' },
];

const habits = [
  { title: 'One region, explored outward', body: 'Pick a base and stay put. Everything else becomes a short drive or a slow train — and the place has time to reveal itself.' },
  { title: 'The market before the museum', body: 'A Saturday market says more about a town than most attractions do. Go for the cheese; stay for the conversation.' },
  { title: 'Shoulder season, always', body: 'Spring and autumn light is longer and kinder, the villages are quieter, and the good tables have room.' },
];
---

<BaseLayout title="The Unhurried Traveler — European Travel Journal & Photography">
  <!-- ============ HERO ============ -->
  <section class="relative pt-[68px]">
    <div class="grid lg:grid-cols-[1.12fr_0.88fr]">
      <!-- photo -->
      <div class="relative h-[46svh] min-h-[320px] overflow-hidden sm:h-[56svh] lg:h-[calc(100svh-68px)]">
        <img
          src={withBase('/images/scenes/hero-village.svg')}
          alt="A hilltop stone village catching golden-hour light above terraced hills"
          class="h-full w-full object-cover"
          fetchpriority="high"
        />
        <span class="caption-hand absolute bottom-5 left-5 text-cream-hi/95 drop-shadow-[0_1px_2px_rgba(48,46,42,0.5)] sm:bottom-7 sm:left-7 sm:text-[1.5rem]">
          morning light, somewhere in Umbria
        </span>
        <!-- torn paper seam into the panel (large screens) -->
        <svg class="absolute right-[-1px] top-0 hidden h-full w-8 text-cream lg:block dark:text-dusk-950" viewBox="0 0 32 600" preserveAspectRatio="none" aria-hidden="true">
          <path fill="currentColor" d="M12 0 L32 0 L32 600 L14 600 L20 560 L8 520 L18 480 L10 440 L22 400 L12 360 L20 320 L9 280 L18 240 L11 200 L21 160 L10 120 L17 80 L12 40 Z" />
        </svg>
      </div>

      <!-- text panel -->
      <div class="relative flex items-center px-6 py-14 sm:px-10 lg:px-14 lg:py-0">
        <!-- faint route line -->
        <svg class="pointer-events-none absolute right-6 top-10 hidden w-56 lg:block" viewBox="0 0 220 120" fill="none" aria-hidden="true">
          <path class="route-line" d="M4 60 C60 10 120 110 216 40" />
          <circle cx="4" cy="60" r="3" fill="currentColor" class="text-terracotta" />
          <circle cx="216" cy="40" r="3" fill="currentColor" class="text-terracotta" />
        </svg>

        <div class="relative mx-auto w-full max-w-xl lg:pt-20">
          <p class="eyebrow">A Slow Travel Journal</p>
          <h1 class="mt-5 font-display text-5xl font-semibold leading-[1.04] tracking-tight text-ink sm:text-6xl lg:text-[4.2rem] dark:text-cream">
            Europe,<br />taken slowly.
          </h1>
          <span class="rule-tick mt-6 block" aria-hidden="true"></span>
          <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-soft dark:text-cream/75">
            Photographs, stories, villages, markets, and discoveries from the roads between the famous places.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a
              href={withBase('/blog/')}
              class="inline-flex items-center gap-2.5 bg-olive-dark px-7 py-3.5 text-[0.72rem] font-bold uppercase tracking-[0.18em] text-cream-hi transition-all duration-200 hover:bg-terracotta-dark"
            >
              Latest Journal Entry
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
            <a
              href={withBase('/destinations/')}
              class="group inline-flex items-center gap-2 text-[0.72rem] font-bold uppercase tracking-[0.18em] text-ink transition-colors hover:text-terracotta-dark dark:text-cream dark:hover:text-terracotta-light"
            >
              <span class="border-b border-terracotta/50 pb-1 transition-colors group-hover:border-terracotta">View the Travel Map</span>
            </a>
          </div>

          <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
            {[
              [`${destinationCount}`, 'destinations'],
              [`${posts.length}`, 'journal entries'],
              ['1', 'bag, never checked'],
            ].map(([n, label]) => (
              <p class="flex items-baseline gap-2">
                <span class="font-display text-2xl font-semibold text-terracotta-dark dark:text-terracotta-light">{n}</span>
                <span class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-ink-faint dark:text-cream/55">{label}</span>
              </p>
            ))}
          </div>

          <Decor name="seal" label="THE ROADS BETWEEN" sublabel="THE FAMOUS PLACES" class="absolute -top-2 right-0 hidden size-24 text-terracotta/45 lg:block" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FROM THE JOURNAL ============ -->
  <section class="mx-auto max-w-7xl px-6 pt-24 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="reveal">
        <p class="script text-2xl">From the Journal</p>
        <p class="mt-1 max-w-md text-sm leading-relaxed text-ink-soft dark:text-cream/65">
          Long-form field notes and photographs — villages, architecture, markets, and the craft of going somewhere slowly.
        </p>
      </div>
      <a href={withBase('/blog/')} class="reveal inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-terracotta-dark transition-transform duration-300 hover:translate-x-1 dark:text-terracotta-light">
        View all stories
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <!-- featured -->
      <article class="reveal group">
        <a href={withBase(`/blog/${featured.id}/`)} class="block">
          <div class="relative overflow-hidden rounded-[3px]">
            <img src={withBase(featured.data.coverImage)} alt="" class="aspect-[16/11] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]" fetchpriority="high" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>
            <span class="absolute left-5 top-5 bg-terracotta px-3 py-1 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-cream-hi">Featured</span>
            <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cream-hi/80">{featured.data.tags[0]} · {dateLabel(featured.data.pubDate)}</p>
              <h3 class="mt-2 max-w-lg font-display text-2xl font-semibold leading-snug text-cream-hi sm:text-[2rem]">{featured.data.title}</h3>
            </div>
          </div>
        </a>
      </article>

      <!-- two secondary entries -->
      <div class="flex flex-col justify-between gap-6">
        {secondary.map((post, i) => (
          <article class="reveal group flex gap-5" style={`--reveal-delay:${(i + 1) * 110}ms`}>
            <a href={withBase(`/blog/${post.id}/`)} class="w-2/5 shrink-0 overflow-hidden rounded-[3px]">
              <img src={withBase(post.data.coverImage)} alt="" class="aspect-[4/5] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.05]" loading="lazy" />
            </a>
            <div class="flex flex-col justify-center border-b border-limestone/50 pb-6 dark:border-cream/8">
              <p class="text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-olive-dark dark:text-terracotta-light">{post.data.tags[0]} · {dateLabel(post.data.pubDate)}</p>
              <a href={withBase(`/blog/${post.id}/`)}>
                <h3 class="mt-1.5 font-display text-xl font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-terracotta-dark dark:text-cream dark:group-hover:text-terracotta-light">{post.data.title}</h3>
              </a>
              <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft dark:text-cream/60">{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PHOTO STRIP ============ -->
  <section class="mt-24 border-y border-limestone/50 bg-parchment/40 py-14 dark:border-cream/8 dark:bg-dusk-900/40">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="reveal flex items-center justify-between gap-4">
        <p class="eyebrow">The Roads Between</p>
        <span class="script text-xl">so many places, so little hurry</span>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {strip.map((s, i) => (
          <figure class:list={['reveal group relative overflow-hidden rounded-[3px]', i === 2 && 'col-span-2 sm:col-span-1']} style={`--reveal-delay:${i * 90}ms`}>
            <img src={withBase(s.src)} alt={s.cap} loading="lazy" class="aspect-[4/5] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.06]" />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 to-transparent px-3 pb-2.5 pt-8 text-[0.68rem] font-medium text-cream-hi/90">{s.cap}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ MAP ============ -->
  <section class="mx-auto max-w-7xl px-6 pt-24 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Destinations"
        title="Where the roads have led"
        intro="Every marker is a place I've walked, ridden, or driven through — with honest notes on season, pace, and what's worth the detour."
      />
      <Decor name="olive" class="reveal hidden w-40 text-olive/70 sm:block" />
    </div>
    <div class="mt-12">
      <EuropeMap />
    </div>
  </section>

  <!-- ============ NOTES / HABITS ============ -->
  <section class="mt-24 border-y border-limestone/50 bg-parchment/50 py-20 dark:border-cream/8 dark:bg-dusk-900/50">
    <div class="mx-auto max-w-7xl px-6 sm:px-8">
      <div class="reveal flex flex-col items-center text-center">
        <Decor name="sprig" class="h-16 text-olive/70" />
        <p class="eyebrow mt-3">Notes from the Road</p>
        <h2 class="mt-3 font-display text-[2rem] font-semibold tracking-tight text-ink sm:text-[2.4rem] dark:text-cream">A few habits worth keeping</h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-5xl gap-10 md:grid-cols-3">
        {habits.map((h, i) => (
          <div class="reveal text-center" style={`--reveal-delay:${i * 120}ms`}>
            <span class="font-display text-3xl font-semibold text-terracotta/60 dark:text-terracotta-light/70">0{i + 1}</span>
            <h3 class="mt-3 font-display text-xl font-semibold text-ink dark:text-cream">{h.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-soft dark:text-cream/65">{h.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GEAR ============ -->
  <section class="mx-auto max-w-7xl px-6 pt-24 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="What I Carry"
        title="Gear that earns its place"
        intro="Everything fits in one bag I can lift overhead myself. These are the pieces that survive the cut, trip after trip."
      />
      <a
        href={withBase('/gear/')}
        class="reveal inline-flex items-center gap-2 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-terracotta-dark transition-transform duration-300 hover:translate-x-1 dark:text-terracotta-light"
      >
        Browse the kit
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {gear.map((item, i) => <GearCard item={item} delay={i * 120} />)}
    </div>
  </section>

  <!-- ============ NEWSLETTER ============ -->
  <section class="mx-auto max-w-7xl px-6 pt-24 sm:px-8">
    <div class="reveal relative overflow-hidden border border-limestone/60 bg-cream-hi/70 px-8 py-14 sm:px-16 dark:border-cream/10 dark:bg-dusk-800/60">
      <Decor name="paravion" class="pointer-events-none absolute -right-4 top-6 hidden w-40 rotate-6 text-slate/30 sm:block" />
      <div class="relative max-w-xl">
        <p class="script text-2xl">A postcard from the road.</p>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-cream">
          Letters worth the wait
        </h2>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-soft dark:text-cream/65">
          Occasional notes from the road, new photographs, village discoveries, and cheeses worth remembering. No spam, no recycled itineraries — just the good stuff.
        </p>
        <form class="mt-8 flex max-w-md flex-col gap-3 sm:flex-row" action="mailto:wefeltlikeit@gmail.com" method="get">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            name="subject"
            placeholder="you@example.com"
            required
            class="w-full flex-1 border border-limestone-dark/50 bg-cream-hi px-5 py-3.5 text-sm text-ink placeholder:text-ink-faint focus:border-terracotta focus:outline-none focus:ring-1 focus:ring-terracotta/40 dark:border-cream/15 dark:bg-dusk-900/70 dark:text-cream dark:placeholder:text-cream/35"
          />
          <button
            type="submit"
            class="bg-terracotta px-6 py-3.5 text-[0.72rem] font-bold uppercase tracking-[0.16em] text-cream-hi transition-colors hover:bg-terracotta-dark"
          >
            Send me postcards
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
