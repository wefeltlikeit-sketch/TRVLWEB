---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import GearCard from '../components/GearCard.astro';
import EuropeMap from '../components/EuropeMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { withBase } from '../lib/paths';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 3);

const gear = (await getCollection('gear')).sort(
  (a, b) => Number(b.data.sponsor) - Number(a.data.sponsor)
).slice(0, 3);

const destinationCount = (await getCollection('destinations')).length;

const values = [
  {
    title: 'Unhurried by design',
    body: 'One base, short distances, long lunches. Slow is not a compromise for the older traveler — it is the strategy that sees more.',
    icon: 'M12 8v4l2.5 2.5M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Z',
  },
  {
    title: 'Alone, never lonely',
    body: 'Counter lunches, café tables, pub corners, train windows. Europe was built with a seat for the party of one.',
    icon: 'M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM21 21v-1.5a4 4 0 0 0-3-3.85',
  },
  {
    title: 'Out of phase',
    body: 'We can travel whenever we like — so the shoulder season is ours. Famous places, quiet mornings, half the price.',
    icon: 'M8 2v4M16 2v4M3 9h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm4.5 9.5 2 2 3.5-4',
  },
];
---

<BaseLayout title="The Unhurried Traveler — Solo European Travel, At Your Own Pace">
  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-svh items-center overflow-hidden">
    <img
      src={withBase('/images/covers/hero.svg')}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950/80 via-brand-950/30 to-brand-950/40"></div>

    <div class="relative mx-auto w-full max-w-6xl px-6 pt-32 pb-20">
      <div class="glass-deep max-w-2xl rounded-[2rem] p-8 shadow-2xl shadow-brand-950/50 sm:p-12">
        <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.3em] text-accent-300">
          <span class="inline-block h-px w-10 bg-accent-400"></span>
          Solo · Europe · 60 and beyond
        </p>
        <h1 class="mt-6 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-white sm:text-6xl">
          The best journeys<br />
          <span class="text-accent-300">begin after sixty.</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
          Field notes, films, and honest advice from a solo traveler taking Europe's villages,
          cathedrals, and coastlines at exactly the pace they deserve.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href={withBase('/blog/')}
            class="inline-flex items-center gap-2 rounded-xl bg-accent-500 px-6 py-3.5 text-sm font-semibold text-ink-950 shadow-lg shadow-accent-500/30 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-400"
          >
            Read the journal
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
          <a
            href={withBase('/destinations/')}
            class="inline-flex items-center gap-2 rounded-xl border border-white/25 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-400 hover:text-accent-300"
          >
            Explore the map
          </a>
        </div>
      </div>

      <!-- stat strip -->
      <div class="mt-10 flex max-w-2xl flex-wrap gap-x-10 gap-y-4 px-2">
        {[
          [`${destinationCount}`, 'destinations charted'],
          [`${posts.length}`, 'journal entries'],
          ['1', 'bag, never checked'],
        ].map(([n, label]) => (
          <p class="flex items-baseline gap-2.5">
            <span class="font-display text-3xl font-semibold text-accent-300">{n}</span>
            <span class="text-xs font-medium uppercase tracking-[0.18em] text-white/70">{label}</span>
          </p>
        ))}
      </div>
    </div>

    <!-- scroll cue -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-float text-white/60" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m-6-6 6 6 6-6"/></svg>
    </div>
  </section>

  <!-- ============ LATEST ENTRIES ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="The Journal"
        title="Latest field notes"
        intro="Deep-dive travel logs from the road — architecture, villages, and the practical craft of traveling alone well."
      />
      <a
        href={withBase('/blog/')}
        class="reveal inline-flex items-center gap-1.5 rounded-xl border border-brand-800/20 px-5 py-2.5 text-sm font-semibold text-brand-800 transition-all duration-200 hover:border-accent-500 hover:text-accent-600 dark:border-white/15 dark:text-paper/85 dark:hover:text-accent-400"
      >
        All entries
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>

    <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {latest.map((post, i) => <PostCard post={post} delay={i * 120} />)}
    </div>
  </section>

  <!-- ============ MAP ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-28">
    <SectionHeading
      eyebrow="The Chart"
      title="Where the journeys have led"
      intro="Every marker is a route I've walked, ridden, or driven alone — with honest notes on season, pace, and what not to miss."
    />
    <div class="mt-12">
      <EuropeMap />
    </div>
  </section>

  <!-- ============ PHILOSOPHY ============ -->
  <section class="relative mt-28 overflow-hidden bg-gradient-to-br from-brand-950 via-brand-900 to-ink-900 py-24">
    <div class="pointer-events-none absolute -left-32 top-0 size-96 rounded-full bg-accent-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeading
        eyebrow="The Philosophy"
        title="Three rules for the road"
        align="center"
      />
      <div class="mx-auto mt-14 grid max-w-5xl gap-6 md:grid-cols-3">
        {values.map((v, i) => (
          <div class="reveal glass-deep rounded-3xl p-8 transition-transform duration-500 hover:-translate-y-1.5" style={`--reveal-delay:${i * 130}ms`}>
            <span class="grid size-12 place-items-center rounded-2xl bg-accent-500/15 text-accent-300">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={v.icon} /></svg>
            </span>
            <h3 class="mt-5 font-display text-xl font-semibold text-white">{v.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/70">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GEAR ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="The Kit"
        title="Gear that earns its place"
        intro="Everything I carry fits in one bag I can lift overhead myself. These are the pieces that survive the cut, trip after trip."
      />
      <a
        href={withBase('/gear/')}
        class="reveal inline-flex items-center gap-1.5 rounded-xl border border-brand-800/20 px-5 py-2.5 text-sm font-semibold text-brand-800 transition-all duration-200 hover:border-accent-500 hover:text-accent-600 dark:border-white/15 dark:text-paper/85 dark:hover:text-accent-400"
      >
        Full kit list
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>
    <div class="mt-12 grid gap-7 md:grid-cols-3">
      {gear.map((item, i) => <GearCard item={item} delay={i * 120} />)}
    </div>
  </section>

  <!-- ============ NEWSLETTER ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-28">
    <div class="reveal glass relative overflow-hidden rounded-[2rem] p-10 text-center shadow-xl sm:p-16">
      <div class="pointer-events-none absolute -right-20 -top-20 size-64 rounded-full bg-accent-500/15 blur-3xl" aria-hidden="true"></div>
      <p class="text-xs font-bold uppercase tracking-[0.28em] text-accent-600 dark:text-accent-400">Postcards, occasionally</p>
      <h2 class="mx-auto mt-4 max-w-xl font-display text-3xl font-semibold tracking-tight text-brand-900 sm:text-4xl dark:text-paper">
        One honest letter from the road, most months
      </h2>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-ink-800/75 dark:text-paper/65">
        No itineraries recycled from press releases. Just what worked, what didn't, and where the quiet mornings are. Unsubscribe anytime.
      </p>
      <form class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row" action="mailto:wefeltlikeit@gmail.com" method="get">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="subject"
          placeholder="you@example.com"
          required
          class="w-full flex-1 rounded-xl border border-brand-800/20 bg-white/80 px-5 py-3.5 text-sm text-ink-900 placeholder:text-ink-800/40 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-500/30 dark:border-white/15 dark:bg-ink-900/70 dark:text-paper dark:placeholder:text-paper/35"
        />
        <button
          type="submit"
          class="rounded-xl bg-brand-800 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-900/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-600 dark:bg-brand-700"
        >
          Join the list
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
