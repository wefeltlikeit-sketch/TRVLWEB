---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import GearCard from '../components/GearCard.astro';
import EuropeMap from '../components/EuropeMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { withBase } from '../lib/paths';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 3);

const gear = (await getCollection('gear')).sort(
  (a, b) => Number(b.data.sponsor) - Number(a.data.sponsor)
).slice(0, 3);

const destinationCount = (await getCollection('destinations')).length;

const values = [
  {
    title: 'Slow by design',
    body: 'One town as a base, short drives, long lunches. Slow isn’t a compromise — it’s how the light, the market stalls, and the back lanes actually get seen.',
    icon: 'M12 8v4l2.5 2.5M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Z',
  },
  {
    title: 'The roads between',
    body: 'Some of the best mornings never make the guidebook — a cheese stall setting up, fog over a valley, a lane with no name. The camera goes everywhere I do.',
    icon: 'M4 8h3l2-2.5h6L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Zm8 8.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z',
  },
  {
    title: 'Shoulder season, always',
    body: 'Spring and autumn light is longer and kinder, the villages are quieter, and the good tables have room. I plan around the season before the destination.',
    icon: 'M8 2v4M16 2v4M3 9h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm4.5 9.5 2 2 3.5-4',
  },
];
---

<BaseLayout title="The Unhurried Traveler — European Travel Journal & Photography">
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-cream dark:bg-dusk-950">
    <div class="grid lg:min-h-[92svh] lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
      <div class="relative h-[52svh] sm:h-[62svh] lg:h-auto">
        <img
          src={withBase('/images/covers/hero.svg')}
          alt="A hilltop European village catching golden-hour light, seen across a river"
          class="absolute inset-0 h-full w-full object-cover"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/20 via-transparent to-transparent" aria-hidden="true"></div>
        <p class="caption-hand absolute bottom-6 left-6 text-cream-hi drop-shadow-sm sm:bottom-8 sm:left-8 sm:text-xl">
          somewhere between the famous places
        </p>
      </div>

      <div class="relative flex items-center px-6 py-14 sm:px-10 lg:px-14 lg:py-0">
        <div class="mx-auto w-full max-w-xl pt-6 lg:pt-24">
          <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.24em] text-terracotta-dark dark:text-terracotta-light">
            <span class="inline-block h-px w-10 bg-terracotta"></span>
            European Travel Journal
          </p>
          <h1 class="mt-6 font-display text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-5xl lg:text-[3.35rem] dark:text-cream">
            Europe, taken slowly.
          </h1>
          <p class="mt-6 max-w-md text-base leading-relaxed text-ink-soft sm:text-lg dark:text-cream/75">
            Photographs, stories, villages, markets, and discoveries from the roads between the famous places.
          </p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a
              href={withBase('/blog/')}
              class="inline-flex items-center gap-2 rounded-lg bg-terracotta px-6 py-3.5 text-sm font-semibold text-cream-hi shadow-md shadow-terracotta/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-terracotta-dark"
            >
              Explore the Journal
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
            <a
              href={withBase('/destinations/')}
              class="inline-flex items-center gap-2 rounded-lg border border-limestone-dark/50 px-6 py-3.5 text-sm font-semibold text-ink transition-all duration-200 hover:-translate-y-0.5 hover:border-terracotta hover:text-terracotta-dark dark:border-cream/20 dark:text-cream dark:hover:text-terracotta-light"
            >
              View the Travel Map
            </a>
          </div>

          <!-- stat strip -->
          <div class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
            {[
              [`${destinationCount}`, 'destinations charted'],
              [`${posts.length}`, 'journal entries'],
              ['1', 'bag, never checked'],
            ].map(([n, label]) => (
              <p class="flex items-baseline gap-2.5">
                <span class="font-display text-3xl font-semibold text-terracotta-dark dark:text-terracotta-light">{n}</span>
                <span class="text-xs font-medium uppercase tracking-[0.16em] text-ink-faint dark:text-cream/55">{label}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LATEST ENTRIES ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="The Journal"
        title="Latest from the road"
        intro="Deep-dive travel notes and photographs — villages, architecture, markets, and the practical craft of getting somewhere slowly."
      />
      <a
        href={withBase('/blog/')}
        class="reveal inline-flex items-center gap-1.5 rounded-lg border border-limestone-dark/40 px-5 py-2.5 text-sm font-semibold text-ink transition-all duration-200 hover:border-terracotta hover:text-terracotta-dark dark:border-cream/15 dark:text-cream/85 dark:hover:text-terracotta-light"
      >
        All entries
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>

    <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {latest.map((post, i) => <PostCard post={post} delay={i * 120} />)}
    </div>
  </section>

  <!-- ============ MAP ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-28">
    <SectionHeading
      eyebrow="Destinations"
      title="Where the roads have led"
      intro="Every marker is a place I've walked, ridden, or driven through — with honest notes on season, pace, and what's actually worth the detour."
    />
    <div class="mt-12">
      <EuropeMap />
    </div>
  </section>

  <!-- ============ VALUES ============ -->
  <section class="dark relative mt-28 overflow-hidden bg-gradient-to-br from-dusk-950 via-[#2c2117] to-dusk-900 py-24">
    <div class="pointer-events-none absolute -left-32 top-0 size-96 rounded-full bg-terracotta/10 blur-3xl" aria-hidden="true"></div>
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeading
        eyebrow="Notes from the Road"
        title="A few habits worth keeping"
        align="center"
      />
      <div class="mx-auto mt-14 grid max-w-5xl gap-6 md:grid-cols-3">
        {values.map((v, i) => (
          <div class="reveal glass-deep rounded-lg p-8 transition-transform duration-500 hover:-translate-y-1.5" style={`--reveal-delay:${i * 130}ms`}>
            <span class="grid size-12 place-items-center rounded-lg bg-terracotta/20 text-terracotta-light">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={v.icon} /></svg>
            </span>
            <h3 class="mt-5 font-display text-xl font-semibold text-cream-hi">{v.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-cream/70">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ GEAR ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="What I Carry"
        title="Gear that earns its place"
        intro="Everything fits in one bag I can lift overhead myself. These are the pieces that survive the cut, trip after trip."
      />
      <a
        href={withBase('/gear/')}
        class="reveal inline-flex items-center gap-1.5 rounded-lg border border-limestone-dark/40 px-5 py-2.5 text-sm font-semibold text-ink transition-all duration-200 hover:border-terracotta hover:text-terracotta-dark dark:border-cream/15 dark:text-cream/85 dark:hover:text-terracotta-light"
      >
        Full kit list
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>
    <div class="mt-12 grid gap-7 md:grid-cols-3">
      {gear.map((item, i) => <GearCard item={item} delay={i * 120} />)}
    </div>
  </section>

  <!-- ============ NEWSLETTER ============ -->
  <section class="mx-auto max-w-6xl px-6 pt-28">
    <div class="reveal glass relative overflow-hidden rounded-lg p-10 text-center shadow-lg sm:p-16">
      <div class="pointer-events-none absolute -right-20 -top-20 size-64 rounded-full bg-terracotta/15 blur-3xl" aria-hidden="true"></div>
      <p class="text-xs font-bold uppercase tracking-[0.24em] text-terracotta-dark dark:text-terracotta-light">Postcards, occasionally</p>
      <h2 class="mx-auto mt-4 max-w-xl font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-cream">
        A note from the road, most months
      </h2>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-ink-soft dark:text-cream/65">
        Occasional notes from the road, new photographs, village discoveries, and cheeses worth remembering. No itineraries recycled from press releases. Unsubscribe anytime.
      </p>
      <form class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row" action="mailto:wefeltlikeit@gmail.com" method="get">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          type="email"
          name="subject"
          placeholder="you@example.com"
          required
          class="w-full flex-1 rounded-lg border border-limestone-dark/40 bg-cream-hi/80 px-5 py-3.5 text-sm text-ink placeholder:text-ink-faint focus:border-terracotta focus:outline-none focus:ring-2 focus:ring-terracotta/30 dark:border-cream/15 dark:bg-dusk-900/70 dark:text-cream dark:placeholder:text-cream/35"
        />
        <button
          type="submit"
          class="rounded-lg bg-ink px-6 py-3.5 text-sm font-semibold text-cream-hi shadow-md shadow-ink/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-terracotta-dark dark:bg-terracotta-dark"
        >
          Send me postcards
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
