---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EuropeMap from '../components/EuropeMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { withBase } from '../lib/paths';

const destinations = (await getCollection('destinations')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const paceStyle = {
  gentle: 'bg-accent-500/12 text-accent-600 dark:text-accent-400',
  moderate: 'bg-amber-500/12 text-amber-600 dark:text-amber-400',
  active: 'bg-rose-500/12 text-rose-600 dark:text-rose-400',
} as const;
---

<BaseLayout
  title="Destination Map — The Unhurried Traveler"
  description="An interactive chart of solo journeys across Europe, with honest notes on season, walking pace, and what not to miss at each destination."
>
  <section class="mx-auto max-w-6xl px-6 pt-36">
    <SectionHeading
      eyebrow="The Chart"
      title="Journeys, plotted"
      intro="Select any marker for field notes: the season that suits it, how demanding it is on foot, and the things I'd go back for. New pins appear as new journeys are made."
    />
    <div class="mt-12">
      <EuropeMap />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-24">
    <h2 class="reveal font-display text-2xl font-semibold tracking-tight text-brand-900 dark:text-paper">The gazetteer</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map((d, i) => (
        <article
          class="reveal group flex flex-col rounded-3xl border border-brand-800/10 bg-white p-7 shadow-sm transition-all duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-brand-900/15 dark:border-white/10 dark:bg-ink-800"
          style={`--reveal-delay:${(i % 3) * 110}ms`}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[0.65rem] font-bold uppercase tracking-[0.22em] text-brand-700 dark:text-accent-400">{d.data.country}</p>
              <h3 class="mt-1.5 font-display text-xl font-semibold tracking-tight text-brand-900 dark:text-paper">{d.data.name}</h3>
            </div>
            <span class:list={['rounded-full px-3 py-1 text-[0.62rem] font-bold uppercase tracking-wider', paceStyle[d.data.pace]]}>
              {d.data.pace}
            </span>
          </div>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-800/75 dark:text-paper/65">{d.data.summary}</p>
          <p class="mt-4 text-xs font-medium text-ink-800/60 dark:text-paper/50">
            <span class="font-bold uppercase tracking-wider text-brand-700 dark:text-accent-400">Season · </span>
            {d.data.bestSeason}
          </p>
          {d.data.relatedPost && (
            <a
              href={withBase(`/blog/${d.data.relatedPost}/`)}
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-600 transition-transform duration-300 group-hover:translate-x-1 dark:text-accent-400"
            >
              Read the journal entry
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
