---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EuropeMap from '../components/EuropeMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { withBase } from '../lib/paths';

const destinations = (await getCollection('destinations')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const paceStyle = {
  gentle: 'bg-olive/15 text-olive-dark dark:text-olive-light',
  moderate: 'bg-terracotta/15 text-terracotta-dark dark:text-terracotta-light',
  active: 'bg-burgundy/15 text-burgundy dark:text-burgundy',
} as const;
---

<BaseLayout
  title="Travel Map — The Unhurried Traveler"
  description="An interactive map of journeys across Europe, with honest notes on season, walking pace, and what's worth the detour at each destination."
>
  <section class="mx-auto max-w-6xl px-6 pt-36">
    <SectionHeading
      eyebrow="Destinations"
      title="Journeys, mapped"
      intro="Select any marker for field notes: the season that suits it, how demanding it is on foot, and the things worth going back for. New pins appear as new journeys are made."
    />
    <div class="mt-12">
      <EuropeMap />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-24">
    <h2 class="reveal font-display text-2xl font-semibold tracking-tight text-ink dark:text-cream">The gazetteer</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map((d, i) => (
        <article
          class="reveal group flex flex-col rounded-lg border border-limestone/50 bg-cream-hi p-7 shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg hover:shadow-ink/10 dark:border-cream/10 dark:bg-dusk-800"
          style={`--reveal-delay:${(i % 3) * 110}ms`}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-olive-dark dark:text-terracotta-light">{d.data.country}</p>
              <h3 class="mt-1.5 font-display text-xl font-semibold tracking-tight text-ink dark:text-cream">{d.data.name}</h3>
            </div>
            <span class:list={['rounded-full px-3 py-1 text-[0.62rem] font-bold uppercase tracking-wider', paceStyle[d.data.pace]]}>
              {d.data.pace}
            </span>
          </div>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft dark:text-cream/65">{d.data.summary}</p>
          <p class="mt-4 text-xs font-medium text-ink-faint dark:text-cream/50">
            <span class="font-bold uppercase tracking-wider text-olive-dark dark:text-terracotta-light">Season · </span>
            {d.data.bestSeason}
          </p>
          {d.data.relatedPost && (
            <a
              href={withBase(`/blog/${d.data.relatedPost}/`)}
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-terracotta-dark transition-transform duration-300 group-hover:translate-x-1 dark:text-terracotta-light"
            >
              Read the journal entry
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
