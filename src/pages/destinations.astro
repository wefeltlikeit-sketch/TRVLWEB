---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EuropeMap from '../components/EuropeMap.astro';
import Decor from '../components/Decor.astro';
import { withBase } from '../lib/paths';

const destinations = (await getCollection('destinations')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const paceStyle = {
  gentle: 'text-olive-dark dark:text-olive-light',
  moderate: 'text-terracotta-dark dark:text-terracotta-light',
  active: 'text-burgundy dark:text-burgundy',
} as const;
---

<BaseLayout
  title="Travel Map — The Unhurried Traveler"
  description="A map of journeys across Europe, with honest notes on season, walking pace, and what's worth the detour at each destination."
>
  <section class="mx-auto max-w-7xl px-6 pt-32 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="reveal max-w-2xl">
        <p class="flex items-center gap-3"><span class="rule-tick"></span><span class="eyebrow">Destinations</span></p>
        <h1 class="mt-4 font-display text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-6xl dark:text-cream">Journeys, mapped</h1>
        <p class="mt-4 text-base leading-relaxed text-ink-soft dark:text-cream/65">
          Select any marker for field notes: the season that suits it, how demanding it is on foot, and the things worth going back for. New pins appear as new journeys are made.
        </p>
      </div>
      <Decor name="compass" class="reveal hidden w-24 text-terracotta/45 sm:block" />
    </div>
    <div class="mt-12">
      <EuropeMap />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pt-24 sm:px-8">
    <p class="reveal script text-2xl">The gazetteer</p>
    <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map((d, i) => (
        <article
          class="reveal group flex flex-col border-t border-limestone/60 pt-6 dark:border-cream/10"
          style={`--reveal-delay:${(i % 3) * 100}ms`}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[0.62rem] font-bold uppercase tracking-[0.18em] text-olive-dark dark:text-terracotta-light">{d.data.country}</p>
              <h3 class="mt-1 font-display text-xl font-semibold tracking-tight text-ink dark:text-cream">{d.data.name}</h3>
            </div>
            <span class:list={['text-[0.6rem] font-bold uppercase tracking-[0.14em]', paceStyle[d.data.pace]]}>{d.data.pace}</span>
          </div>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft dark:text-cream/65">{d.data.summary}</p>
          <p class="mt-4 text-xs font-medium text-ink-faint dark:text-cream/50">
            <span class="font-bold uppercase tracking-wider text-olive-dark dark:text-terracotta-light">Season · </span>
            {d.data.bestSeason}
          </p>
          {d.data.relatedPost && (
            <a
              href={withBase(`/blog/${d.data.relatedPost}/`)}
              class="mt-4 inline-flex items-center gap-1.5 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-terracotta-dark transition-transform duration-300 group-hover:translate-x-1 dark:text-terracotta-light"
            >
              Read the journal entry
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
