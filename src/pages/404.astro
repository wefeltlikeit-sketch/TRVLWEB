---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Page not found — The Unhurried Traveler">
  <section class="mx-auto flex min-h-[70svh] max-w-3xl flex-col items-center justify-center px-6 pt-32 text-center">
    <p class="font-display text-7xl font-semibold text-accent-500">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold tracking-tight text-brand-900 dark:text-paper">
      A wrong turn — the best kind
    </h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-800/70 dark:text-paper/60">
      This page has wandered off the map. In Alfama we'd call that the whole point,
      but here's the way back to the marked trail.
    </p>
    <a
      href={withBase('/')}
      class="mt-8 inline-flex items-center gap-2 rounded-xl bg-accent-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-accent-600/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-500"
    >
      Back to the start
    </a>
  </section>
</BaseLayout>
