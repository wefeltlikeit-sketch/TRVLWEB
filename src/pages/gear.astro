---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GearCard from '../components/GearCard.astro';
import Decor from '../components/Decor.astro';

const gear = (await getCollection('gear')).sort((a, b) => {
  if (a.data.sponsor !== b.data.sponsor) return Number(b.data.sponsor) - Number(a.data.sponsor);
  return a.data.name.localeCompare(b.data.name);
});
---

<BaseLayout
  title="Camera & Travel Gear — The Unhurried Traveler"
  description="The complete travel kit: one carry-on bag, a pocket camera department, and the pieces that survive the cut trip after trip."
>
  <section class="mx-auto max-w-7xl px-6 pt-32 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="reveal max-w-2xl">
        <p class="flex items-center gap-3"><span class="rule-tick"></span><span class="eyebrow">What I Carry</span></p>
        <h1 class="mt-4 font-display text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-6xl dark:text-cream">Camera &amp; travel gear</h1>
        <p class="mt-4 text-base leading-relaxed text-ink-soft dark:text-cream/65">
          The whole system fits in one 40-litre bag I can lift overhead without help — that single constraint decides everything below. Items marked "Partner" support the site; the opinions remain stubbornly my own.
        </p>
      </div>
      <Decor name="drone" class="reveal hidden w-32 text-ink/25 sm:block dark:text-cream/20" />
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {gear.map((item, i) => <GearCard item={item} delay={(i % 3) * 100} />)}
    </div>

    <div class="reveal mt-16 border border-limestone/60 bg-parchment/50 p-8 sm:p-10 dark:border-cream/10 dark:bg-dusk-800">
      <div>
        <p class="script text-2xl">Pack less. Choose well.</p>
        <h2 class="mt-1 font-display text-xl font-semibold text-ink dark:text-cream">The one-bag habit</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-cream/65">
          Checked luggage is a leash: it ties you to carousels, to porters, to hotels with lifts, to taxis with boots.
          One bag under ten kilograms means every train connection is easy, every cobbled lane is passable, and every
          change of plan costs nothing. If a piece of gear can't justify its grams, it stays home — and each year,
          the bag gets a little lighter while the journeys get a little longer.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
