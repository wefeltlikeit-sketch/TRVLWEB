---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import PostCard from '../../components/PostCard.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, coverImage, youtubeId, tags, sponsors, coordinates } = post.data;

const dateLabel = pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(2, Math.round(words / 210));

const sponsorEntries = (
  await Promise.all(sponsors.map((id) => getEntry('gear', id)))
).filter((e) => e != null);

const all = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const index = all.findIndex((p) => p.id === post.id);
const newer = index > 0 ? all[index - 1] : null;
const older = index < all.length - 1 ? all[index + 1] : null;

const more = all.filter((p) => p.id !== post.id).slice(0, 3);
---

<BaseLayout title={`${title} — The Unhurried Traveler`} description={description} ogImage={coverImage}>
  <!-- title block on paper -->
  <section class="mx-auto max-w-3xl px-6 pt-36 text-center">
    <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-olive-dark dark:text-terracotta-light">
      {tags.slice(0, 3).map((tag, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <span>{tag}</span>
        </>
      ))}
    </p>
    <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.12] tracking-tight text-ink sm:text-5xl dark:text-cream">
      {title}
    </h1>
    <p class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs font-medium uppercase tracking-[0.14em] text-ink-faint dark:text-cream/50">
      <span>{dateLabel}</span>
      <span aria-hidden="true">·</span>
      <span>{readMinutes} min read</span>
      {coordinates && (
        <>
          <span aria-hidden="true">·</span>
          <span>{Math.abs(coordinates[1]).toFixed(2)}°{coordinates[1] >= 0 ? 'N' : 'S'} {Math.abs(coordinates[0]).toFixed(2)}°{coordinates[0] >= 0 ? 'E' : 'W'}</span>
        </>
      )}
    </p>
  </section>

  <!-- cover photo -->
  <figure class="mx-auto mt-10 max-w-5xl px-6">
    <div class="overflow-hidden rounded-[3px]">
      <img src={withBase(coverImage)} alt="" class="aspect-[16/9] w-full object-cover" fetchpriority="high" />
    </div>
  </figure>

  <!-- body -->
  <article class="mx-auto max-w-3xl px-6 pt-12">
    <p class="font-display text-xl italic leading-relaxed text-ink sm:text-[1.4rem] dark:text-cream">
      {description}
    </p>

    {youtubeId && <YouTubeEmbed id={youtubeId} title={`Watch: ${title}`} />}

    <div class="prose-journal mt-10">
      <Content />
    </div>

    {sponsorEntries.length > 0 && (
      <aside class="mt-14 border border-limestone/60 bg-parchment/50 p-7 dark:border-cream/10 dark:bg-dusk-800">
        <p class="eyebrow">Made possible by</p>
        <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
          {sponsorEntries.map((s) => (
            <li>
              {s.data.link ? (
                <a href={s.data.link} rel="noopener sponsored" target="_blank" class="text-sm font-semibold text-ink underline decoration-terracotta decoration-2 underline-offset-4 transition-colors hover:text-terracotta-dark dark:text-cream">
                  {s.data.name}
                </a>
              ) : (
                <span class="text-sm font-semibold text-ink dark:text-cream">{s.data.name}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs leading-relaxed text-ink-faint dark:text-cream/50">
          Partners never see an entry before it is published, and the opinions — like the journeys — are entirely my own.
        </p>
      </aside>
    )}

    <nav class="mt-14 grid gap-4 border-t border-limestone/50 pt-10 sm:grid-cols-2 dark:border-cream/10" aria-label="More entries">
      {older ? (
        <a href={withBase(`/blog/${older.id}/`)} class="group border border-limestone/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-terracotta/50 hover:shadow-md dark:border-cream/10">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.18em] text-ink-faint dark:text-cream/40">← Earlier journey</p>
          <p class="mt-2 font-display font-semibold leading-snug text-ink group-hover:text-terracotta-dark dark:text-cream dark:group-hover:text-terracotta-light">{older.data.title}</p>
        </a>
      ) : <span></span>}
      {newer && (
        <a href={withBase(`/blog/${newer.id}/`)} class="group border border-limestone/60 p-6 text-right transition-all duration-300 hover:-translate-y-1 hover:border-terracotta/50 hover:shadow-md dark:border-cream/10">
          <p class="text-[0.62rem] font-bold uppercase tracking-[0.18em] text-ink-faint dark:text-cream/40">Later journey →</p>
          <p class="mt-2 font-display font-semibold leading-snug text-ink group-hover:text-terracotta-dark dark:text-cream dark:group-hover:text-terracotta-light">{newer.data.title}</p>
        </a>
      )}
    </nav>
  </article>

  <section class="mx-auto max-w-7xl px-6 pt-24 sm:px-8">
    <h2 class="reveal font-display text-2xl font-semibold tracking-tight text-ink dark:text-cream">Keep reading</h2>
    <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {more.map((p, i) => <PostCard post={p} delay={i * 100} />)}
    </div>
  </section>
</BaseLayout>
