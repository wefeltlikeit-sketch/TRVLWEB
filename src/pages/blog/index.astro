---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Decor from '../../components/Decor.astro';
import { withBase } from '../../lib/paths';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const lead = posts[0];
const rest = posts.slice(1);

const dateLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Travel Journal — The Unhurried Traveler"
  description="Long-form field notes and photographs from across Europe: villages, architecture, markets, and the craft of going somewhere slowly."
>
  <section class="mx-auto max-w-7xl px-6 pt-32 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="reveal max-w-2xl">
        <p class="flex items-center gap-3"><span class="rule-tick"></span><span class="eyebrow">The Journal</span></p>
        <h1 class="mt-4 font-display text-4xl font-semibold leading-[1.1] tracking-tight text-ink sm:text-6xl dark:text-cream">Field notes from the road</h1>
        <p class="mt-4 text-base leading-relaxed text-ink-soft dark:text-cream/65">
          Every entry starts with a place I went to see for myself — written for travelers who'd rather know one place well than five from a coach window.
        </p>
      </div>
      <Decor name="camera" class="reveal hidden w-28 text-ink/25 sm:block dark:text-cream/20" />
    </div>

    <!-- lead entry -->
    <article data-tags={lead.data.tags.join('|')} class="post-cell reveal group mt-12 grid gap-8 lg:grid-cols-2 lg:items-center">
      <a href={withBase(`/blog/${lead.id}/`)} class="relative overflow-hidden rounded-[3px]">
        <img src={withBase(lead.data.coverImage)} alt="" class="aspect-[16/11] w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]" fetchpriority="high" />
        <span class="absolute left-5 top-5 bg-terracotta px-3 py-1 text-[0.6rem] font-bold uppercase tracking-[0.16em] text-cream-hi">Latest</span>
      </a>
      <div>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-olive-dark dark:text-terracotta-light">{lead.data.tags[0]} · {dateLabel(lead.data.pubDate)}</p>
        <a href={withBase(`/blog/${lead.id}/`)}>
          <h2 class="mt-2 font-display text-3xl font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-terracotta-dark sm:text-4xl dark:text-cream dark:group-hover:text-terracotta-light">{lead.data.title}</h2>
        </a>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-ink-soft dark:text-cream/65">{lead.data.description}</p>
        <span class="mt-5 inline-flex items-center gap-2 text-[0.72rem] font-bold uppercase tracking-[0.16em] text-terracotta-dark transition-transform duration-300 group-hover:translate-x-1 dark:text-terracotta-light">
          Read the story
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </span>
      </div>
    </article>

    <!-- tag filter -->
    <div class="reveal mt-16 flex flex-wrap gap-2 border-t border-limestone/50 pt-8 dark:border-cream/8" role="group" aria-label="Filter entries by tag">
      <button type="button" data-filter="all" class="filter-chip is-active">All</button>
      {tags.map((tag) => (
        <button type="button" data-filter={tag} class="filter-chip">{tag}</button>
      ))}
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" id="post-grid">
      {rest.map((post, i) => (
        <div data-tags={post.data.tags.join('|')} class="post-cell">
          <PostCard post={post} delay={Math.min(i, 5) * 90} />
        </div>
      ))}
    </div>

    <p id="no-results" class="mt-16 hidden text-center text-sm text-ink-faint dark:text-cream/50">
      No entries under that tag yet — the notebook is still open.
    </p>
  </section>

  <style>
    .filter-chip {
      border: 1px solid color-mix(in srgb, var(--color-limestone-dark) 55%, transparent);
      border-radius: 999px;
      padding: 0.5rem 1rem;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-ink-soft);
      transition: all 200ms ease;
    }
    :global(.dark) .filter-chip { color: color-mix(in srgb, var(--color-cream) 80%, transparent); border-color: color-mix(in srgb, var(--color-cream) 15%, transparent); }
    .filter-chip:hover { border-color: var(--color-terracotta); color: var(--color-terracotta-dark); }
    .filter-chip.is-active { background: var(--color-terracotta); border-color: var(--color-terracotta); color: var(--color-cream-hi); }
  </style>

  <script>
    function armFilters() {
      const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
      const cells = document.querySelectorAll<HTMLElement>('.post-cell');
      const empty = document.getElementById('no-results');
      if (!chips.length || chips[0].dataset.armed) return;
      chips[0].dataset.armed = 'true';

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.toggle('is-active', c === chip));
          const filter = chip.dataset.filter;
          let visible = 0;
          cells.forEach((cell) => {
            const show = filter === 'all' || (cell.dataset.tags ?? '').split('|').includes(filter!);
            cell.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          empty?.classList.toggle('hidden', visible > 0);
        });
      });
    }
    armFilters();
    document.addEventListener('astro:page-load', armFilters);
  </script>
</BaseLayout>
