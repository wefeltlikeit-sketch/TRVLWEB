---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { withBase } from '../../lib/paths';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const featured = posts.slice(0, 2);
const rest = posts.slice(2);

const dateLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Travel Journal — The Unhurried Traveler"
  description="Deep-dive travel notes and photographs from across Europe: villages, architecture, markets, and the practical craft of getting somewhere slowly."
>
  <section class="mx-auto max-w-6xl px-6 pt-36">
    <SectionHeading
      eyebrow="The Journal"
      title="Field notes from the road"
      intro="Every entry starts with a place I went to see for myself — written for travelers who'd rather know one place well than five from a coach window."
    />

    <!-- tag filter -->
    <div class="reveal mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter entries by tag">
      <button
        type="button"
        data-filter="all"
        class="filter-chip is-active rounded-full border border-limestone-dark/40 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-ink transition-all duration-200 dark:border-cream/15 dark:text-cream/80"
      >
        All
      </button>
      {tags.map((tag) => (
        <button
          type="button"
          data-filter={tag}
          class="filter-chip rounded-full border border-limestone-dark/40 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-ink transition-all duration-200 dark:border-cream/15 dark:text-cream/80"
        >
          {tag}
        </button>
      ))}
    </div>

    <!-- featured entries: alternating image/text layout -->
    <div class="mt-12 flex flex-col gap-8" id="featured-grid">
      {featured.map((post, i) => (
        <div data-tags={post.data.tags.join('|')} class="post-cell">
          <article class:list={[
            'reveal group grid overflow-hidden rounded-lg border border-limestone/50 bg-cream-hi shadow-sm transition-all duration-500 hover:shadow-lg hover:shadow-ink/10 dark:border-cream/10 dark:bg-dusk-800 lg:grid-cols-2',
          ]} style={`--reveal-delay:${i * 120}ms`}>
            <a
              href={withBase(`/blog/${post.id}/`)}
              class:list={['relative aspect-[16/10] overflow-hidden lg:aspect-auto', i % 2 === 1 && 'lg:order-2']}
            >
              <img
                src={withBase(post.data.coverImage)}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
              />
              <div class="absolute inset-x-4 top-4 flex flex-wrap gap-2">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="glass-deep rounded-full px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-wider text-cream-hi">{tag}</span>
                ))}
              </div>
            </a>
            <a href={withBase(`/blog/${post.id}/`)} class="flex flex-col justify-center p-8 sm:p-10">
              <p class="text-xs font-medium uppercase tracking-[0.14em] text-olive-dark dark:text-terracotta-light">{dateLabel(post.data.pubDate)}</p>
              <h3 class="mt-3 font-display text-2xl font-semibold leading-snug tracking-tight text-ink transition-colors duration-200 group-hover:text-terracotta-dark sm:text-[1.7rem] dark:text-cream dark:group-hover:text-terracotta-light">
                {post.data.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-cream/65">{post.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-terracotta-dark transition-transform duration-300 group-hover:translate-x-1 dark:text-terracotta-light">
                Read the entry
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </span>
            </a>
          </article>
        </div>
      ))}
    </div>

    <div class="mt-8 grid gap-7 md:grid-cols-2 lg:grid-cols-3" id="post-grid">
      {rest.map((post, i) => (
        <div data-tags={post.data.tags.join('|')} class="post-cell">
          <PostCard post={post} delay={Math.min(i, 5) * 100} />
        </div>
      ))}
    </div>

    <p id="no-results" class="mt-16 hidden text-center text-sm text-ink-faint dark:text-cream/50">
      No entries under that tag yet — the notebook is still open.
    </p>
  </section>

  <style>
    .filter-chip:hover {
      border-color: var(--color-terracotta);
      color: var(--color-terracotta-dark);
    }
    .filter-chip.is-active {
      background: var(--color-terracotta);
      border-color: var(--color-terracotta);
      color: var(--color-cream-hi);
    }
  </style>

  <script>
    function armFilters() {
      const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
      const cells = document.querySelectorAll<HTMLElement>('.post-cell');
      const empty = document.getElementById('no-results');
      if (!chips.length || chips[0].dataset.armed) return;
      chips[0].dataset.armed = 'true';

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.toggle('is-active', c === chip));
          const filter = chip.dataset.filter;
          let visible = 0;
          cells.forEach((cell) => {
            const show = filter === 'all' || (cell.dataset.tags ?? '').split('|').includes(filter!);
            cell.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          empty?.classList.toggle('hidden', visible > 0);
        });
      });
    }
    armFilters();
    document.addEventListener('astro:page-load', armFilters);
  </script>
</BaseLayout>
