---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'gear'>;
  delay?: number;
}

const { item, delay = 0 } = Astro.props;
const { name, category, tagline, description, link, sponsor, icon } = item.data;

const icons: Record<string, string> = {
  drone: 'M5 7a2 2 0 1 0 0.01 0M19 7a2 2 0 1 0 .01 0M5 17a2 2 0 1 0 .01 0M19 17a2 2 0 1 0 .01 0M6.5 8.5l3 3m5-3-3 3m-5 4 3-3m5 3-3-3m1-1.5h.01M9.5 12a2.5 2.5 0 1 0 5 0 2.5 2.5 0 0 0-5 0',
  camera: 'M4 8h3l2-2.5h6L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Zm8 8.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z',
  bag: 'M8 8V6a4 4 0 0 1 8 0v2m-9.5 0h11L19 20H5L6.5 8Z',
  shoes: 'M3 16c0-1 .5-4 .8-5.4L5.5 11l2-2 2.5 2.5c1.6 1.6 4 2.5 6.5 2.5H21v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Zm7-3.5L8.5 14M12.7 13.7 11.5 15',
  audio: 'M4 13a8 8 0 0 1 16 0m-16 0v4a2 2 0 0 0 2 2h1v-6H6a2 2 0 0 0-2 2Zm16 0v4a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2Z',
  power: 'M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2Z',
  stay: 'M3 19V9.5L12 4l9 5.5V19m-15 0v-6h4v6m3-6h5v6M3 19h18',
};
---

<article
  class="reveal group relative flex flex-col rounded-3xl border border-brand-800/10 bg-white p-7 shadow-sm transition-all duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-brand-900/15 dark:border-white/10 dark:bg-ink-800"
  style={`--reveal-delay:${delay}ms`}
>
  {sponsor && (
    <span class="absolute right-5 top-5 rounded-full bg-accent-500/12 px-2.5 py-1 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-accent-600 dark:text-accent-400">
      Partner
    </span>
  )}

  <span class="grid size-12 place-items-center rounded-2xl bg-brand-800/10 text-brand-800 transition-colors duration-300 group-hover:bg-accent-600 group-hover:text-white dark:bg-white/8 dark:text-accent-400">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={icons[icon] ?? icons.bag} />
    </svg>
  </span>

  <p class="mt-5 text-[0.65rem] font-bold uppercase tracking-[0.22em] text-brand-700 dark:text-accent-400">{category}</p>
  <h3 class="mt-1.5 font-display text-lg font-semibold tracking-tight text-brand-900 dark:text-paper">{name}</h3>
  <p class="mt-1 text-sm font-medium text-accent-600 dark:text-accent-400">{tagline}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-800/75 dark:text-paper/65">{description}</p>

  {link && (
    <a
      href={link}
      rel="noopener sponsored"
      target="_blank"
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-800 transition-colors hover:text-accent-600 dark:text-paper/85 dark:hover:text-accent-400"
    >
      View details
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8" />
      </svg>
    </a>
  )}
</article>
