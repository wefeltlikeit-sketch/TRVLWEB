---
/**
 * Restrained editorial decorations: postal seal, pressed botanicals, and
 * fine line-art doodles. All strokes use currentColor, so colour them with a
 * Tailwind text-* class and size/position with the `class` prop.
 *
 *   <Decor name="seal" class="size-28 text-terracotta/70" />
 *   <Decor name="olive" class="w-24 text-olive" />
 */
interface Props {
  name: 'seal' | 'sprig' | 'olive' | 'camera' | 'drone' | 'paravion' | 'compass';
  label?: string;
  sublabel?: string;
  class?: string;
}

const {
  name,
  label = 'THE ROADS BETWEEN',
  sublabel = 'THE FAMOUS PLACES',
  class: className = '',
} = Astro.props;

const uid = 'd' + Math.random().toString(36).slice(2, 8);
---

{name === 'seal' && (
  <svg viewBox="0 0 120 120" class={className} fill="none" aria-hidden="true">
    <defs>
      <path id={`${uid}-top`} d="M60 60 m-44 0 a44 44 0 1 1 88 0" />
      <path id={`${uid}-bot`} d="M60 60 m44 0 a44 44 0 1 1 -88 0" />
    </defs>
    <circle cx="60" cy="60" r="56" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <circle cx="60" cy="60" r="47" stroke="currentColor" stroke-width="1.4" />
    <text font-family="var(--font-sans)" font-size="7.6" font-weight="700" letter-spacing="2.4" fill="currentColor">
      <textPath href={`#${uid}-top`} startOffset="50%" text-anchor="middle">{label}</textPath>
    </text>
    <text font-family="var(--font-sans)" font-size="7.6" font-weight="700" letter-spacing="2.4" fill="currentColor">
      <textPath href={`#${uid}-bot`} startOffset="50%" text-anchor="middle">{sublabel}</textPath>
    </text>
    <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M60 44 C60 52 60 62 60 74" />
      <path d="M60 52 C55 49 51 50 48 47 C53 46 57 48 60 52 Z" fill="currentColor" fill-opacity="0.12" />
      <path d="M60 58 C65 55 69 56 72 53 C67 52 63 54 60 58 Z" fill="currentColor" fill-opacity="0.12" />
      <path d="M60 64 C55 61 51 62 48 59 C53 58 57 60 60 64 Z" fill="currentColor" fill-opacity="0.12" />
      <circle cx="60" cy="41" r="2.4" fill="currentColor" fill-opacity="0.15" />
    </g>
    <text x="60" y="34" font-family="var(--font-sans)" font-size="4.4" font-weight="700" letter-spacing="1.6" fill="currentColor" text-anchor="middle" opacity="0.7">✦ ✦ ✦</text>
  </svg>
)}

{name === 'sprig' && (
  <svg viewBox="0 0 80 120" class={className} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M40 118 C40 90 40 54 42 26" />
    <g fill="currentColor" fill-opacity="0.1">
      <path d="M42 34 C52 30 60 34 66 26 C56 22 47 26 42 34 Z" />
      <path d="M41 48 C31 44 23 48 17 40 C27 36 36 40 41 48 Z" />
      <path d="M41 64 C51 60 59 64 65 56 C55 52 46 56 41 64 Z" />
      <path d="M40 80 C30 76 22 80 16 72 C26 68 35 72 40 80 Z" />
    </g>
    <g fill="currentColor">
      <circle cx="40" cy="20" r="2.6" />
      <circle cx="34" cy="24" r="2" />
      <circle cx="46" cy="24" r="2" />
    </g>
  </svg>
)}

{name === 'olive' && (
  <svg viewBox="0 0 160 60" class={className} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M6 34 C50 24 110 22 154 28" />
    <g fill="currentColor" fill-opacity="0.12">
      <path d="M34 30 C30 22 34 15 44 14 C46 24 42 30 34 30 Z" />
      <path d="M58 32 C56 23 62 17 72 18 C71 28 66 33 58 32 Z" />
      <path d="M86 31 C84 22 90 16 100 17 C99 27 94 32 86 31 Z" />
      <path d="M48 36 C46 44 40 49 31 47 C33 38 40 34 48 36 Z" />
      <path d="M74 38 C73 46 66 51 57 48 C60 40 67 37 74 38 Z" />
    </g>
    <g fill="currentColor" fill-opacity="0.85">
      <ellipse cx="112" cy="30" rx="5" ry="7" transform="rotate(18 112 30)" />
      <ellipse cx="126" cy="34" rx="5" ry="7" transform="rotate(18 126 34)" />
      <ellipse cx="120" cy="42" rx="5" ry="7" transform="rotate(18 120 42)" />
    </g>
  </svg>
)}

{name === 'camera' && (
  <svg viewBox="0 0 120 90" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 30 h16 l7 -10 h26 l7 10 h30 a6 6 0 0 1 6 6 v40 a6 6 0 0 1 -6 6 H14 a6 6 0 0 1 -6 -6 V36 a6 6 0 0 1 6 -6 Z" />
    <circle cx="63" cy="56" r="17" />
    <circle cx="63" cy="56" r="9" />
    <path d="M92 40 h10" />
    <path d="M22 30 v-6 h12 v6" />
  </svg>
)}

{name === 'drone' && (
  <svg viewBox="0 0 130 80" class={className} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="52" y="34" width="26" height="14" rx="4" />
    <path d="M52 40 L30 26 M78 40 L100 26" />
    <path d="M14 24 h32 M84 24 h32" />
    <ellipse cx="30" cy="24" rx="16" ry="3.5" opacity="0.55" />
    <ellipse cx="100" cy="24" rx="16" ry="3.5" opacity="0.55" />
    <path d="M58 48 l-6 10 M72 48 l6 10" />
    <path d="M50 60 h12 M68 60 h12" />
  </svg>
)}

{name === 'paravion' && (
  <svg viewBox="0 0 150 90" class={className} fill="none" aria-hidden="true">
    <rect x="4" y="4" width="142" height="82" rx="3" stroke="currentColor" stroke-width="1.3" stroke-dasharray="4 4" />
    <g fill="currentColor">
      {Array.from({ length: 12 }).map((_, i) => (
        <rect x={12 + i * 11} y="14" width="7" height="4" transform={`skewX(-20)`} opacity={i % 2 ? 0.5 : 0.85} />
      ))}
    </g>
    <text x="75" y="52" font-family="var(--font-sans)" font-size="15" font-weight="700" letter-spacing="3" fill="currentColor" text-anchor="middle">PAR AVION</text>
    <path d="M28 68 h94" stroke="currentColor" stroke-width="1" opacity="0.5" />
    <path d="M40 74 l70 -2 -66 6 26 -8 -20 10" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linejoin="round" opacity="0.7" />
  </svg>
)}

{name === 'compass' && (
  <svg viewBox="0 0 80 80" class={className} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="40" cy="40" r="30" />
    <circle cx="40" cy="40" r="24" opacity="0.4" />
    <path d="M40 16 L45 40 L40 64 L35 40 Z" fill="currentColor" fill-opacity="0.15" />
    <path d="M16 40 L40 35 L64 40 L40 45 Z" fill="currentColor" fill-opacity="0.05" />
    <text x="40" y="13" font-family="var(--font-sans)" font-size="7" font-weight="700" fill="currentColor" text-anchor="middle">N</text>
    <circle cx="40" cy="40" r="2.4" fill="currentColor" />
  </svg>
)}
