---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class:list={['flex items-center gap-3', align === 'center' && 'justify-center']}>
    <span class="rule-tick" aria-hidden="true"></span>
    <span class="eyebrow">{eyebrow}</span>
  </p>
  <h2 class="mt-4 font-display text-[2rem] font-semibold leading-[1.12] tracking-tight text-ink sm:text-[2.6rem] dark:text-cream">
    {title}
  </h2>
  {intro && <p class="mt-4 text-base leading-relaxed text-ink-soft dark:text-cream/65">{intro}</p>}
</div>
