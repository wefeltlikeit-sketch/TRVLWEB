---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class:list={['reveal max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class:list={['flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.24em] text-terracotta-dark dark:text-terracotta-light', align === 'center' && 'justify-center']}>
    <span class="inline-block h-px w-8 bg-terracotta/50" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-cream">
    {title}
  </h2>
  {intro && <p class="mt-4 text-base leading-relaxed text-ink-soft dark:text-cream/65">{intro}</p>}
</div>
