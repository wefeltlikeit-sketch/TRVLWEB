---
import { withBase } from '../lib/paths';

const nav = [
  { href: '/blog/', label: 'Journal' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/markets/', label: 'Markets' },
  { href: '/films/', label: 'Films' },
  { href: '/gear/', label: 'Gear' },
  { href: '/about/', label: 'About' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(withBase(href).replace(/\/$/, ''));
---

<header class="glass fixed inset-x-0 top-0 z-50 border-b border-ink/8 dark:border-cream/8">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
    <a href={withBase('/')} class="group flex items-center gap-3" aria-label="The Unhurried Traveler — home">
      <span class="grid size-9 shrink-0 place-items-center rounded-full border border-terracotta/40 text-terracotta-dark transition-colors duration-300 group-hover:bg-terracotta group-hover:text-cream-hi dark:text-terracotta-light">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4" />
          <path d="M15.5 8.5 13.2 13.2 8.5 15.5l2.3-4.7z" fill="currentColor" />
        </svg>
      </span>
      <span class="leading-[1.05]">
        <span class="block font-display text-[1.15rem] font-semibold tracking-tight text-ink dark:text-cream">The Unhurried</span>
        <span class="block font-display text-[1.15rem] font-semibold tracking-tight text-ink dark:text-cream">Traveler</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'relative text-[0.7rem] font-semibold uppercase tracking-[0.18em] transition-colors duration-200 after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-terracotta after:transition-all after:duration-300',
            isActive(item.href)
              ? 'text-terracotta-dark after:w-full dark:text-terracotta-light'
              : 'text-ink-soft after:w-0 hover:text-ink hover:after:w-full dark:text-cream/75 dark:hover:text-cream',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <span class="script hidden text-xl xl:block">Slow down. Stay curious.</span>
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full text-ink-soft transition-colors hover:bg-ink/8 dark:text-cream/85 dark:hover:bg-cream/10"
        aria-label="Toggle dark mode"
      >
        <svg class="hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19" />
        </svg>
        <svg class="dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.6 14.2A8.6 8.6 0 1 1 9.8 3.4a7 7 0 1 0 10.8 10.8Z" />
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full text-ink-soft transition-colors hover:bg-ink/8 md:hidden dark:text-cream/85 dark:hover:bg-cream/10"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink/8 bg-cream-hi/95 md:hidden dark:border-cream/8 dark:bg-dusk-900/95">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-2" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'border-b border-ink/6 py-3.5 text-sm font-semibold uppercase tracking-[0.16em] transition-colors last:border-0 dark:border-cream/8',
            isActive(item.href)
              ? 'text-terracotta-dark dark:text-terracotta-light'
              : 'text-ink-soft hover:text-ink dark:text-cream/85',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function armHeader() {
    const themeBtn = document.getElementById('theme-toggle');
    if (!themeBtn || themeBtn.dataset.armed) return;
    themeBtn.dataset.armed = 'true';
    themeBtn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });

    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(open));
    });
  }
  armHeader();
  document.addEventListener('astro:page-load', armHeader);
</script>
