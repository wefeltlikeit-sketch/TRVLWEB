---
import { withBase } from '../lib/paths';

const nav = [
  { href: '/blog/', label: 'Journal' },
  { href: '/destinations/', label: 'Destinations' },
  { href: '/gear/', label: 'Gear' },
  { href: '/about/', label: 'About' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(withBase(href).replace(/\/$/, ''));
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <div class="glass mx-auto flex max-w-6xl items-center justify-between rounded-2xl px-5 py-3 shadow-lg shadow-ink/5">
    <a href={withBase('/')} class="group flex items-center gap-3" aria-label="The Unhurried Traveler — home">
      <span class="grid size-9 place-items-center rounded-xl bg-terracotta text-cream-hi transition-colors duration-300 group-hover:bg-terracotta-dark">
        <!-- compass mark -->
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
          <path d="M15.5 8.5 13.2 13.2 8.5 15.5l2.3-4.7z" fill="currentColor" />
        </svg>
      </span>
      <span class="leading-none">
        <span class="block whitespace-nowrap font-display text-[1.05rem] font-semibold tracking-tight text-ink dark:text-cream">The Unhurried Traveler</span>
        <span class="mt-0.5 hidden whitespace-nowrap text-[0.62rem] font-medium uppercase tracking-[0.2em] text-olive-dark dark:text-terracotta-light sm:block">Villages · Markets · Slow Roads</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'rounded-lg px-3.5 py-2 text-sm font-medium transition-colors duration-200',
            isActive(item.href)
              ? 'bg-terracotta/15 text-terracotta-dark dark:text-terracotta-light'
              : 'text-ink-soft hover:bg-ink/6 hover:text-ink dark:text-cream/80 dark:hover:bg-cream/8 dark:hover:text-terracotta-light',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-xl text-ink-soft transition-colors hover:bg-ink/8 dark:text-cream/85 dark:hover:bg-cream/10"
        aria-label="Toggle dark mode"
      >
        <svg class="hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19" />
        </svg>
        <svg class="dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.6 14.2A8.6 8.6 0 1 1 9.8 3.4a7 7 0 1 0 10.8 10.8Z" />
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-xl text-ink-soft transition-colors hover:bg-ink/8 md:hidden dark:text-cream/85 dark:hover:bg-cream/10"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mx-auto mt-2 hidden max-w-6xl md:hidden">
    <nav class="glass flex flex-col gap-1 rounded-2xl p-3 shadow-lg !bg-cream/95 dark:!bg-dusk-900/95" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'rounded-xl px-4 py-3 text-base font-medium transition-colors',
            isActive(item.href)
              ? 'bg-terracotta/15 text-terracotta-dark dark:text-terracotta-light'
              : 'text-ink-soft hover:bg-ink/6 dark:text-cream/85 dark:hover:bg-cream/8',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function armHeader() {
    const themeBtn = document.getElementById('theme-toggle');
    if (!themeBtn || themeBtn.dataset.armed) return;
    themeBtn.dataset.armed = 'true';
    themeBtn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });

    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(open));
    });
  }
  armHeader();
  document.addEventListener('astro:page-load', armHeader);
</script>
